# Boomviagens — exemplo de configuração (SEM credenciais reais)
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
SESSION_SECRET=trocar-por-segredo-longo-e-aleatorio

# Base de dados
DB_MODE=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Autentica os pedidos do Vercel Cron (ex.: /api/cron/prune-logs) - a Vercel
# envia sozinha "Authorization: Bearer <isto>" quando esta variavel esta
# definida no projeto. Sem isto, essas rotas recusam tudo (fail closed).
CRON_SECRET=

# Admin bootstrap (necessários no primeiro arranque; em produção nunca usar admin123)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=trocar

# Pesquisa demo — false em Preview/Production quando quiser apenas stock real
ENABLE_DEMO_SEARCH=false

# TourDiez
TOURDIEZ_MODE=mock
TOURDIEZ_BASE_URL=
TOURDIEZ_USER=
TOURDIEZ_PASSWORD=
TOURDIEZ_AGENCY_CODE=
TOURDIEZ_DEFAULT_CITY=
TOURDIEZ_DEFAULT_ACCOMMODATIONS=

# Duffel
DUFFEL_API_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com

# HBX / Hotelbeds
HBX_MODE=test
HBX_BASE_URL=https://api.test.hotelbeds.com
HBX_ALLOW_LAZY_CONTENT=true
HBX_HOTELS_API_KEY=
HBX_HOTELS_SECRET=
HBX_ACTIVITIES_API_KEY=
HBX_ACTIVITIES_SECRET=
HBX_TRANSFERS_API_KEY=
HBX_TRANSFERS_SECRET=
# Confirmacao automatica de reservas HBX (createBooking real) + voucher -
# false ate estar validado em sandbox (ver docs/OPERATOR_ADAPTERS.md).
HBX_AUTO_CONFIRM_ENABLED=false

# Enriquecimento
OPENWEATHER_API_KEY=
TICKETMASTER_API_KEY=
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=

# Integrações futuras (convenção usada pelo catálogo de serviços)
# Adicionar apenas quando existir cliente/adaptador testado para o fornecedor.
CRUISE_API_BASE_URL=
CRUISE_API_KEY=
CAR_API_BASE_URL=
CAR_API_KEY=
TRAIN_API_BASE_URL=
TRAIN_API_KEY=
FERRY_API_BASE_URL=
FERRY_API_KEY=
INSURANCE_API_BASE_URL=
INSURANCE_API_KEY=

# Pagamentos
# Desenvolvimento sem gateway: mock. Sandbox/produção: gateway.
# Em produção configure também PUBLIC_BASE_URL com o domínio HTTPS público.
PAYMENTS_MODE=mock
ALLOW_PRODUCTION_MOCK_PAYMENTS=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
EASYPAY_BASE_URL=https://api.test.easypay.pt/2.0
EASYPAY_ACCOUNT_ID=
EASYPAY_API_KEY=

# Faturação
# O cliente (src/facturalusaClient.js) so conhece dois modos: "mock"
# (omissao, nada e emitido) e "real" (emite na API). Qualquer outro valor
# (ex.: "test") cai silenciosamente em mock - usar "real" so com
# FACTURALUSA_API_KEY definida.
FACTURALUSA_MODE=mock
FACTURALUSA_BASE_URL=
FACTURALUSA_API_KEY=

# Email
EMAIL_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Empresa
COMPANY_NAME=Boomviagens
COMPANY_DOMAIN=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_NIF=
COMPANY_RNAVT=
MARKET_COUNTRY=PT
CURRENCY=EUR
PRICE_TYPE=PVP
COMMISSION_INCLUDED=true
CONFIRMATION_MODE=automatic
DEFAULT_MARGIN_PERCENT=5
