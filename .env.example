# Boomviagens - EXEMPLO DE CONFIGURACAO
# NUNCA colocar chaves reais neste ficheiro nem inclui-las em ZIPs/repositorios.
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# Empresa
COMPANY_NAME=About Destiny, Unipessoal Lda
COMPANY_DOMAIN=boomviagens.pt
COMPANY_EMAIL=geral@boomviagens.pt
COMPANY_PHONE=+351960257333
COMPANY_NIF=509080308
COMPANY_RNAVT=INSERIR_NUMERO_RNAVT

# Backoffice
# Em producao ADMIN_USERNAME/ADMIN_PASSWORD sao obrigatorios; o servidor ja
# nao cria admin/admin123 como fallback quando NODE_ENV=production/VERCEL.
ADMIN_USERNAME=definir_utilizador
ADMIN_PASSWORD=definir_password_forte

# Sessoes - OBRIGATORIO em producao. Gerar valor aleatorio longo.
SESSION_SECRET=gerar_um_valor_aleatorio_longo

# Dados comerciais
TOURDIEZ_AGENCY_CODE=
MARKET_COUNTRY=PT
CURRENCY=EUR
PRICE_TYPE=PVP
COMMISSION_INCLUDED=true
DEFAULT_MARGIN_PERCENT=5
CONFIRMATION_MODE=automatic

# Operador TourDiez / Sirio
TOURDIEZ_MODE=mock
TOURDIEZ_BASE_URL=http://testapi.tourdiez.com/2.9/booking/ApiServlet.Srv
TOURDIEZ_USER=
TOURDIEZ_PASSWORD=
TOURDIEZ_DEFAULT_CITY=ES00634
TOURDIEZ_DEFAULT_ACCOMMODATIONS=

# Pagamentos
# mock = permite o botao controlado de simulacao apenas em desenvolvimento.
# Num ambiente real, /api/payment/confirm fica bloqueado e PAID so pode vir
# de webhook validado. A criacao OUTGOING de sessoes Stripe/Easypay ainda
# deve ser concluida antes de abrir pagamentos reais ao publico.
PAYMENTS_MODE=mock

# Stripe (sandbox/teste)
STRIPE_MODE=test
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Easypay Sandbox
EASYPAY_BASE_URL=https://api.test.easypay.pt/2.0
EASYPAY_ACCOUNT_ID=
EASYPAY_API_KEY=

# Facturalusa
# mock = nao emite; real = usa a API configurada. Para testes fiscais usar
# apenas a subscricao/serie de testes confirmada pelo fornecedor.
FACTURALUSA_MODE=mock
FACTURALUSA_BASE_URL=https://facturalusa.pt/api/v2
FACTURALUSA_API_KEY=

# Base de dados
# local = JSON; sqlite = ficheiro local; supabase = recomendado para Vercel.
DB_MODE=sqlite
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=colocar_service_role_key_apenas_no_ambiente_seguro

# Email
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
