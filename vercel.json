{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/prune-logs", "schedule": "0 3 1 * *" },
    { "path": "/api/cron/document-reminders", "schedule": "0 8 */3 * *" },
    { "path": "/api/cron/payment-reconciliation", "schedule": "0 * * * *" },
    { "path": "/api/cron/customer-notifications", "schedule": "0 8 * * *" }
  ]
}
